{
  "name": "source-map-importer",
  "productName": "Source Map Importer",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "main": "app/main.js",
  "description": "Source engine map to Roblox importer with pre-import moderation",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . \"Source Map Importer\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=app/icon.ico --ignore=^/dist --ignore=^/projects --ignore=^/plugin --ignore=^/release --ignore=\\.bat$ --ignore=\\.lnk$",
    "install-plugin": "node plugin/install.js"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.1"
  }
}
